# Tâches planifiées de SYSTELEC SAMA-SHOP (docs/04-mise-en-service.md, sections 6 et 7).
# Installer pour l'utilisateur qui exploite Docker : crontab -e (adapter /srv/systelec, dossier du dépôt).
# Horloge du serveur en UTC (Dakar = UTC+0).
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Expiration des réservations, paniers et devis ; alertes et relances des retours : toutes les 15 minutes.
*/15 * * * * cd /srv/systelec && docker compose -f docker-compose.prod.yml --env-file .env.production run --rm tasks >> /var/log/systelec/taches.log 2>&1

# Sauvegarde nocturne (base + fichiers téléversés) à 2 h. La copie HORS serveur chiffrée doit suivre
# (restic, rclone…) : à ajouter ici une fois l'outil choisi.
0 2 * * * cd /srv/systelec && scripts/ops/backup.sh /srv/sauvegardes >> /var/log/systelec/sauvegardes.log 2>&1
