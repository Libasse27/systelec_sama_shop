{
  "name": "systelec-sama-shop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:migration": "vitest run --project migration",
    "test:integration:disposable": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:test:prepare": "dotenv -e .env.test -- prisma migrate reset --force",
    "db:seed": "tsx --env-file-if-exists=.env --conditions=react-server scripts/seed-base.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env --conditions=react-server scripts/seed-demo.ts",
    "admin:create": "tsx --env-file-if-exists=.env --conditions=react-server scripts/create-super-admin.ts",
    "admin:reset-link": "tsx --env-file-if-exists=.env --conditions=react-server scripts/reset-link.ts",
    "orders:expire": "tsx --env-file-if-exists=.env --conditions=react-server scripts/expire-orders.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-pdf/renderer": "4.9.0",
    "better-auth": "1.7.7",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "nodemailer": "10.0.14",
    "pg": "^8.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "^17.0.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "fflate": "0.8.3",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
