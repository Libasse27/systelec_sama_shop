// SYSTELEC SAMA-SHOP — schéma de données.
// Les modèles sont ajoutés phase par phase (voir docs/02-modele-donnees.md).
// Montants : Int en FCFA. Dates : timestamptz (UTC).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identité (tables Better Auth + champs SYSTELEC) ──────────────────────────

enum UserKind {
  STAFF
  CUSTOMER
}

/// Utilisateur. Le mot de passe (haché) est dans Account ; il n'est jamais lisible.
model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  phone         String?
  kind          UserKind   @default(CUSTOMER)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  roles         UserRole[]
  payments      Payment[]

  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

enum LoginAttemptStatus {
  PENDING
  SUCCESS
  FAILURE
}

/// Tentatives de connexion, pour la limitation de débit. Purgeable (contrairement à l'audit).
model LoginAttempt {
  id        String             @id @default(cuid())
  email     String
  ip        String?
  status    LoginAttemptStatus @default(PENDING)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// ─── Rôles et permissions (RBAC) ─────────────────────────────────────────────

/// Rôle. Les 10 rôles système sont synchronisés depuis le code (src/server/authz/roles.ts).
model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  label       String
  isSystem    Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Permission. La liste fait foi dans le code (src/server/authz/permissions.ts).
model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

/// Catégorie de produits (arborescence). Une catégorie inactive masque son contenu public.
model Category {
  id             String     @id @default(cuid())
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[] @relation("CategoryTree")
  name           String
  slug           String     @unique
  description    String?
  position       Int        @default(0)
  isActive       Boolean    @default(true)
  seoTitle       String?
  seoDescription String?
  products       Product[]
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  @@index([parentId, position])
  @@map("categories")
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("brands")
}

enum ProductCondition {
  NEW
  REFURBISHED
  USED
}

/// « Épuisé » n'est pas un statut : il est calculé depuis le stock disponible.
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id               String                 @id @default(cuid())
  categoryId       String
  category         Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId          String?
  brand            Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  name             String
  slug             String                 @unique
  model            String?
  shortDescription String
  description      String
  condition        ProductCondition       @default(NEW)
  warrantyMonths   Int?
  warrantyText     String?
  /// Caractéristiques techniques : liste de { label, value }.
  specs            Json                   @default("[]")
  weightGrams      Int?
  dimensions       String?
  status           ProductStatus          @default(DRAFT)
  isFeatured       Boolean                @default(false)
  seoTitle         String?
  seoDescription   String?
  publishedAt      DateTime?              @db.Timestamptz(3)
  images           ProductImage[]
  variants         ProductVariant[]
  compatibleWith   ProductCompatibility[] @relation("ProductCompatibility")
  compatibleFrom   ProductCompatibility[] @relation("CompatibleProduct")
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)

  @@index([status, categoryId])
  @@index([status, isFeatured])
  @@index([brandId])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)

  @@index([productId, position])
  @@map("product_images")
}

/// Tout produit a au moins une variante (par défaut) : prix et stock sont portés par la variante.
model ProductVariant {
  id             String          @id @default(cuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String          @unique
  barcode        String?
  name           String
  /// Attributs de la variante (ex. { "Capacité": "1 To" }).
  attributes     Json            @default("{}")
  /// Prix de vente TTC en FCFA (entier).
  price          Int
  /// Prix barré facultatif (promotion affichée), en FCFA.
  compareAtPrice Int?
  /// Prix d'achat interne : JAMAIS exposé au public (sélecteurs explicites).
  costPrice      Int?
  isDefault      Boolean         @default(false)
  isActive       Boolean         @default(true)
  position       Int             @default(0)
  inventory      Inventory?
  movements      StockMovement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  @@index([productId, position])
  @@map("product_variants")
}

/// Stock d'une variante. Disponible = onHand − reserved (contraintes CHECK en base).
model Inventory {
  id             String         @id @default(cuid())
  variantId      String         @unique
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand         Int            @default(0)
  reserved       Int            @default(0)
  alertThreshold Int            @default(0)
  lastCountedAt  DateTime?      @db.Timestamptz(3)
  lastCountedQty Int?
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  @@map("inventories")
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RESERVE
  RELEASE
  SALE
  RETURN
}

/// Journal IMMUABLE des mouvements de stock (trigger PostgreSQL : ni UPDATE ni DELETE).
/// Chaque ligne enregistre la quantité signée et l'état du stock qui en résulte.
model StockMovement {
  id            String            @id @default(cuid())
  variantId     String
  variant       ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  type          StockMovementType
  /// Variation signée du stock physique (IN > 0, OUT < 0…), ou du réservé pour RESERVE/RELEASE.
  quantity      Int
  onHandAfter   Int
  reservedAfter Int
  reason        String
  actorId       String?
  orderId       String?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)

  @@index([variantId, createdAt])
  @@index([createdAt])
  @@map("stock_movements")
}

model ProductCompatibility {
  productId           String
  compatibleProductId String
  product             Product @relation("ProductCompatibility", fields: [productId], references: [id], onDelete: Cascade)
  compatibleProduct   Product @relation("CompatibleProduct", fields: [compatibleProductId], references: [id], onDelete: Cascade)

  @@id([productId, compatibleProductId])
  @@map("product_compatibilities")
}

// ─── Services techniques (catalogue) ─────────────────────────────────────────

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  position    Int       @default(0)
  isActive    Boolean   @default(true)
  services    Service[]

  @@map("service_categories")
}

enum ServicePricingMode {
  FIXED
  INDICATIVE
  QUOTE_ONLY
}

model Service {
  id                String             @id @default(cuid())
  categoryId        String
  category          ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name              String
  slug              String             @unique
  shortDescription  String
  description       String
  imageUrl          String?
  pricingMode       ServicePricingMode @default(QUOTE_ONLY)
  /// Tarif en FCFA ; obligatoire sauf « sur devis » (contrainte CHECK en base).
  price             Int?
  estimatedDuration String?
  zonesText         String?
  conditions        String?
  isActive          Boolean            @default(true)
  isFeatured        Boolean            @default(false)
  position          Int                @default(0)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  @@index([categoryId, position])
  @@map("services")
}

// ─── Contenu ─────────────────────────────────────────────────────────────────

/// Page d'information (CGV, livraison, garantie, confidentialité, à propos). Texte brut par paragraphes.
model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  body           String
  seoDescription String?
  isPublished    Boolean  @default(false)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@map("pages")
}

model FaqItem {
  id          String  @id @default(cuid())
  question    String
  answer      String
  position    Int     @default(0)
  isPublished Boolean @default(true)

  @@map("faq_items")
}

// ─── Paramètres et numérotation ──────────────────────────────────────────────

/// Paramètre administrable. La valeur est validée par un schéma Zod propre à chaque clé.
model SiteSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("site_settings")
}

/// Compteur de numérotation métier (CMD-2026-000001…), incrémenté dans la transaction appelante.
model Sequence {
  key   String
  year  Int
  value Int    @default(0)

  @@id([key, year])
  @@map("sequences")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

/// Journal d'audit append-only : un trigger PostgreSQL interdit UPDATE et DELETE.
model AuditLog {
  id            String      @id @default(cuid())
  actorId       String?
  action        String
  entityType    String?
  entityId      String?
  before        Json?
  after         Json?
  result        AuditResult @default(SUCCESS)
  ip            String?
  correlationId String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([action, entityId, createdAt])
  @@index([action, ip, createdAt])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Phase 6 : panier, commandes, livraison, notifications ─────────────────────

/// Panier d'un compte (userId) ou d'un visiteur (empreinte SHA-256 du jeton de cookie).
model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  tokenHash String?    @unique
  items     CartItem[]
  expiresAt DateTime   @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("carts")
}

/// Aucun prix stocké : le prix est toujours relu en base.
model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

/// Zone de livraison. Aucune zone réelle n'est inventée (D5) : saisie par SYSTELEC.
model DeliveryZone {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  fee          Int
  /// Livraison offerte à partir de ce sous-total (FCFA).
  freeAbove    Int?
  leadTimeText String?
  isActive     Boolean  @default(true)
  position     Int      @default(0)
  orders       Order[]
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@map("delivery_zones")
}

/// Point de retrait. Sans point actif, l'option « retrait » est masquée (D4).
model PickupPoint {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String
  hours     String?
  phone     String?
  isActive  Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("pickup_points")
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

/// Client : rattaché à un compte, ou invité (userId nul). Les notes internes ne sont jamais exposées.
model Customer {
  id            String       @id @default(cuid())
  userId        String?      @unique
  type          CustomerType @default(INDIVIDUAL)
  name          String
  companyName   String?
  phone         String
  email         String?
  internalNotes String?
  orders        Order[]
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  @@index([phone])
  @@map("customers")
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  READY_TO_SHIP
  CANCELLED
  CLOSED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  TO_VERIFY
  REFUND_PENDING
  REFUNDED
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

model Order {
  id                String               @id @default(cuid())
  number            String               @unique
  customerId        String
  customer          Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// Clé d'idempotence envoyée par le formulaire : une double soumission ne crée qu'une commande.
  idempotencyKey    String               @unique
  /// Commande invitée : empreinte du panier d'origine. Seul ce navigateur peut rejouer la soumission.
  guestCartHash     String?
  status            OrderStatus          @default(PENDING_CONFIRMATION)
  paymentStatus     PaymentStatus        @default(UNPAID)
  fulfillmentMethod FulfillmentMethod
  /// Coordonnées et adresse FIGÉES au moment de la commande.
  contact           Json
  shippingAddress   Json?
  deliveryZoneId    String?
  deliveryZone      DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  pickupPointId     String?
  pickupPoint       PickupPoint?         @relation(fields: [pickupPointId], references: [id], onDelete: Restrict)
  subtotal          Int
  deliveryFee       Int
  discountTotal     Int                  @default(0)
  total             Int
  amountPaid        Int                  @default(0)
  notes             String?
  internalNotes     String?
  /// Fin de la réservation du stock si la commande n'est pas confirmée (D3).
  reservedUntil     DateTime?            @db.Timestamptz(3)
  confirmedAt       DateTime?            @db.Timestamptz(3)
  cancelledAt       DateTime?            @db.Timestamptz(3)
  closedAt          DateTime?            @db.Timestamptz(3)
  items             OrderItem[]
  history           OrderStatusHistory[]
  payments          Payment[]
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([status, reservedUntil])
  @@map("orders")
}

/// Ligne de commande : nom, référence et prix FIGÉS.
model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName String
  variantName String
  sku         String
  unitPrice   Int
  quantity    Int
  lineTotal   Int
  /// Prix d'achat au moment de la vente (marge) : interne, jamais exposé au client.
  unitCost    Int?

  @@index([orderId])
  @@map("order_items")
}

enum OrderHistoryField {
  ORDER
  DELIVERY
  PAYMENT
}

model OrderStatusHistory {
  id        String            @id @default(cuid())
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  field     OrderHistoryField @default(ORDER)
  from      String?
  to        String
  actorId   String?
  comment   String?
  createdAt DateTime          @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

/// Moyens de règlement PHYSIQUES uniquement : aucun moyen électronique n'existe.
enum PaymentMethod {
  CASH
}

/// Encaissement en espèces, en AJOUT SEUL (trigger) : une erreur se corrige par une
/// contre-écriture liée (montant opposé), jamais par modification ni suppression.
/// Le statut de paiement de la commande est recalculé à chaque écriture. Le reçu est
/// généré depuis cette ligne.
model Payment {
  id                String        @id @default(cuid())
  receiptNumber     String        @unique
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// > 0 : encaissement ; < 0 : contre-écriture (annulation d'un encaissement).
  amount            Int
  method            PaymentMethod @default(CASH)
  /// Reste à payer sur la commande juste après cette écriture (figé pour le reçu).
  balanceAfter      Int
  recordedById      String
  recordedBy        User          @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  /// Clé envoyée par le formulaire : un double envoi n'encaisse qu'une fois.
  idempotencyKey    String?       @unique
  /// Contre-écriture : l'encaissement annulé (au plus une annulation par encaissement).
  reversesPaymentId String?       @unique
  reverses          Payment?      @relation("PaymentReversal", fields: [reversesPaymentId], references: [id], onDelete: Restrict)
  reversedBy        Payment?      @relation("PaymentReversal")
  /// Motif d'une contre-écriture (obligatoire), imprimé sur son reçu.
  reason            String?
  /// Note interne, jamais imprimée ni montrée au client.
  note              String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@index([createdAt])
  @@index([recordedById, createdAt])
  @@map("payments")
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_NO_PROVIDER
}

/// Notifications persistées : rien n'est simulé, l'absence de fournisseur est tracée (D11).
model Notification {
  id        String              @id @default(cuid())
  channel   NotificationChannel
  template  String
  recipient String
  payload   Json
  status    NotificationStatus  @default(PENDING)
  error     String?
  orderId   String?
  sentAt    DateTime?           @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([orderId])
  @@map("notifications")
}
