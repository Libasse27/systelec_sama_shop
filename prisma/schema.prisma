// SYSTELEC SAMA-SHOP — schéma de données.
// Les modèles sont ajoutés phase par phase (voir docs/02-modele-donnees.md).
// Montants : Int en FCFA. Dates : timestamptz (UTC).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identité (tables Better Auth + champs SYSTELEC) ──────────────────────────

enum UserKind {
  STAFF
  CUSTOMER
}

/// Utilisateur. Le mot de passe (haché) est dans Account ; il n'est jamais lisible.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  kind          UserKind  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  roles         UserRole[]

  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

enum LoginAttemptStatus {
  PENDING
  SUCCESS
  FAILURE
}

/// Tentatives de connexion, pour la limitation de débit. Purgeable (contrairement à l'audit).
model LoginAttempt {
  id        String             @id @default(cuid())
  email     String
  ip        String?
  status    LoginAttemptStatus @default(PENDING)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// ─── Rôles et permissions (RBAC) ─────────────────────────────────────────────

/// Rôle. Les 10 rôles système sont synchronisés depuis le code (src/server/authz/roles.ts).
model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  label       String
  isSystem    Boolean          @default(true)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Permission. La liste fait foi dans le code (src/server/authz/permissions.ts).
model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

/// Catégorie de produits (arborescence). Une catégorie inactive masque son contenu public.
model Category {
  id             String     @id @default(cuid())
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[] @relation("CategoryTree")
  name           String
  slug           String     @unique
  description    String?
  position       Int        @default(0)
  isActive       Boolean    @default(true)
  seoTitle       String?
  seoDescription String?
  products       Product[]
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  @@index([parentId, position])
  @@map("categories")
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("brands")
}

enum ProductCondition {
  NEW
  REFURBISHED
  USED
}

/// « Épuisé » n'est pas un statut : il est calculé depuis le stock disponible.
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id               String                 @id @default(cuid())
  categoryId       String
  category         Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId          String?
  brand            Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  name             String
  slug             String                 @unique
  model            String?
  shortDescription String
  description      String
  condition        ProductCondition       @default(NEW)
  warrantyMonths   Int?
  warrantyText     String?
  /// Caractéristiques techniques : liste de { label, value }.
  specs            Json                   @default("[]")
  weightGrams      Int?
  dimensions       String?
  status           ProductStatus          @default(DRAFT)
  isFeatured       Boolean                @default(false)
  seoTitle         String?
  seoDescription   String?
  publishedAt      DateTime?              @db.Timestamptz(3)
  images           ProductImage[]
  variants         ProductVariant[]
  compatibleWith   ProductCompatibility[] @relation("ProductCompatibility")
  compatibleFrom   ProductCompatibility[] @relation("CompatibleProduct")
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime               @updatedAt @db.Timestamptz(3)

  @@index([status, categoryId])
  @@index([status, isFeatured])
  @@index([brandId])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  position  Int     @default(0)

  @@index([productId, position])
  @@map("product_images")
}

/// Tout produit a au moins une variante (par défaut) : prix et stock sont portés par la variante.
model ProductVariant {
  id             String     @id @default(cuid())
  productId      String
  product        Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String     @unique
  barcode        String?
  name           String
  /// Attributs de la variante (ex. { "Capacité": "1 To" }).
  attributes     Json       @default("{}")
  /// Prix de vente TTC en FCFA (entier).
  price          Int
  /// Prix barré facultatif (promotion affichée), en FCFA.
  compareAtPrice Int?
  /// Prix d'achat interne : JAMAIS exposé au public (sélecteurs explicites).
  costPrice      Int?
  isDefault      Boolean    @default(false)
  isActive       Boolean    @default(true)
  position       Int        @default(0)
  inventory      Inventory?
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  @@index([productId, position])
  @@map("product_variants")
}

/// Stock d'une variante. Disponible = onHand − reserved (contraintes CHECK en base).
model Inventory {
  id             String         @id @default(cuid())
  variantId      String         @unique
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand         Int            @default(0)
  reserved       Int            @default(0)
  alertThreshold Int            @default(0)
  lastCountedAt  DateTime?      @db.Timestamptz(3)
  lastCountedQty Int?
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  @@map("inventories")
}

model ProductCompatibility {
  productId           String
  compatibleProductId String
  product             Product @relation("ProductCompatibility", fields: [productId], references: [id], onDelete: Cascade)
  compatibleProduct   Product @relation("CompatibleProduct", fields: [compatibleProductId], references: [id], onDelete: Cascade)

  @@id([productId, compatibleProductId])
  @@map("product_compatibilities")
}

// ─── Services techniques (catalogue) ─────────────────────────────────────────

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  position    Int       @default(0)
  isActive    Boolean   @default(true)
  services    Service[]

  @@map("service_categories")
}

enum ServicePricingMode {
  FIXED
  INDICATIVE
  QUOTE_ONLY
}

model Service {
  id                String             @id @default(cuid())
  categoryId        String
  category          ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name              String
  slug              String             @unique
  shortDescription  String
  description       String
  imageUrl          String?
  pricingMode       ServicePricingMode @default(QUOTE_ONLY)
  /// Tarif en FCFA ; obligatoire sauf « sur devis » (contrainte CHECK en base).
  price             Int?
  estimatedDuration String?
  zonesText         String?
  conditions        String?
  isActive          Boolean            @default(true)
  isFeatured        Boolean            @default(false)
  position          Int                @default(0)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  @@index([categoryId, position])
  @@map("services")
}

// ─── Contenu ─────────────────────────────────────────────────────────────────

/// Page d'information (CGV, livraison, garantie, confidentialité, à propos). Texte brut par paragraphes.
model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  body           String
  seoDescription String?
  isPublished    Boolean  @default(false)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  @@map("pages")
}

model FaqItem {
  id          String  @id @default(cuid())
  question    String
  answer      String
  position    Int     @default(0)
  isPublished Boolean @default(true)

  @@map("faq_items")
}

// ─── Paramètres et numérotation ──────────────────────────────────────────────

/// Paramètre administrable. La valeur est validée par un schéma Zod propre à chaque clé.
model SiteSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("site_settings")
}

/// Compteur de numérotation métier (CMD-2026-000001…), incrémenté dans la transaction appelante.
model Sequence {
  key   String
  year  Int
  value Int    @default(0)

  @@id([key, year])
  @@map("sequences")
}

// ─── Audit ───────────────────────────────────────────────────────────────────

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

/// Journal d'audit append-only : un trigger PostgreSQL interdit UPDATE et DELETE.
model AuditLog {
  id            String      @id @default(cuid())
  actorId       String?
  action        String
  entityType    String?
  entityId      String?
  before        Json?
  after         Json?
  result        AuditResult @default(SUCCESS)
  ip            String?
  correlationId String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([action, entityId, createdAt])
  @@index([action, ip, createdAt])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
