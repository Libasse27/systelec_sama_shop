# Modèle de configuration de PRODUCTION (docker-compose.prod.yml). Copier en .env.production,
# remplir, puis : chmod 600 .env.production. Ne JAMAIS versionner .env.production.

# Version des images construites (docker build --target app / --target tools, voir Dockerfile).
APP_VERSION=
APP_IMAGE=systelec-sama-shop
TOOLS_IMAGE=systelec-sama-shop-tools
# Port local écouté par l'application (le reverse proxy TLS y transmet).
APP_PORT=3000

# URL publique du site : https, sans slash final.
APP_URL=https://

# Secret de session : openssl rand -base64 32 (le changer déconnecte tout le monde).
AUTH_SECRET=

# PostgreSQL : propriétaire (migrations, exploitation) et rôle restreint de l'application.
# Mots de passe : openssl rand -hex 24 (24 caractères au moins pour le rôle applicatif).
POSTGRES_DB=systelec
POSTGRES_USER=systelec_owner
POSTGRES_PASSWORD=
APP_DB_USER=systelec_app
APP_DB_PASSWORD=

# Nombre de reverse proxys de confiance devant l'application (1 derrière Caddy ou Nginx).
TRUSTED_PROXY_HOPS=1

# E-mail : désactivé tant que SMTP_HOST est vide (aucun envoi simulé).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
