# Copier en .env (développement) et .env.test (tests). Ne JAMAIS committer de vrais secrets.

# Environnement : development | test | production
APP_ENV=development

# URL publique du site (sans slash final)
APP_URL=http://localhost:3000

# PostgreSQL (docker compose : dev sur 5433, test sur 5434)
DATABASE_URL=postgresql://futani:futani_dev@localhost:5433/futani_dev

# Secret de session (Phase 3). Générer avec : openssl rand -base64 32
AUTH_SECRET=

# Stockage des fichiers téléversés : local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# E-mail (désactivé tant que vide — aucune notification n'est simulée)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Nombre de reverse proxys de confiance devant l'application (lecture de X-Forwarded-For pour
# l'IP client : limitation des tentatives, audit). 1 = derrière nginx/Traefik qui AJOUTE l'IP vue
# ($proxy_add_x_forwarded_for). 0 = application exposée directement (en-tête ignoré).
# En production, l'application doit être servie derrière le reverse proxy.
TRUSTED_PROXY_HOPS=1

# Connexion sociale des CLIENTS (facultative, voir docs/04-mise-en-service.md, section 15). Un fournisseur
# n'est actif que si son identifiant ET son secret sont renseignés ; tout vide = aucun bouton, aucune route.
# URI de redirection à déclarer chez le fournisseur : <APP_URL>/api/auth/callback/<google|facebook|apple|microsoft>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Apple : identifiant du Services ID ; secret = JWT ES256 généré par scripts/ops/apple-client-secret.ts (6 mois maximum).
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# consumers (comptes Microsoft personnels, défaut), common, ou identifiant d'annuaire (GUID).
MICROSOFT_TENANT_ID=consumers
