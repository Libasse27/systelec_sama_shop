# Copier en .env (développement) et .env.test (tests). Ne JAMAIS committer de vrais secrets.

# Environnement : development | test | production
APP_ENV=development

# URL publique du site (sans slash final)
APP_URL=http://localhost:3000

# PostgreSQL (docker compose : dev sur 5433, test sur 5434)
DATABASE_URL=postgresql://systelec:systelec_dev@localhost:5433/systelec_dev

# Secret de session (Phase 3). Générer avec : openssl rand -base64 32
AUTH_SECRET=

# Stockage des fichiers téléversés : local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# E-mail (désactivé tant que vide — aucune notification n'est simulée)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Nombre de reverse proxys de confiance devant l'application (lecture de X-Forwarded-For pour
# l'IP client : limitation des tentatives, audit). 1 = derrière nginx/Traefik qui AJOUTE l'IP vue
# ($proxy_add_x_forwarded_for). 0 = application exposée directement (en-tête ignoré).
# En production, l'application doit être servie derrière le reverse proxy.
TRUSTED_PROXY_HOPS=1
